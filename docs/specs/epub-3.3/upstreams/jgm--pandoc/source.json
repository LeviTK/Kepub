 (char '$')))\n                    <|> (T.singleton <$>\n                           satisfy (\\c -> not\n                                     (isSpaceChar c || c == '\\\\' || c == '{')))\n-                   <|> (char '\\\\' >> (\\c -> T.pack ['\\\\',c]) <$> anyChar)\n                    <|> (T.pack <$> many1 spaceChar <*\n                           (guard (op /= \"$\") <|> notFollowedBy (char '$')))\n+                   <|> (\"\\n\" <$ newline <* notFollowedBy' blankline <*\n+                          (guard (op /= \"$\") <|> notFollowedBy (char '$')))\n+                   <|> (char '\\\\' >> (\\c -> T.pack ['\\\\',c]) <$> anyChar)\n                     ) (try $ textStr cl)\n   when (cl == \"$\") $ notFollowedBy digit  -- to prevent capture of $5\n   return $ trimMath $ T.concat words'"}]}