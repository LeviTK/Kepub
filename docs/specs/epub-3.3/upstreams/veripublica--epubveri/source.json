breaking changes land as minor-version bumps\n (`0.x.0`), per [Cargo's SemVer compatibility\n rules](https://doc.rust-lang.org/cargo/reference/semver.html).\n \n-## [Unreleased]\n+## [0.22.0] - 2026-10-05\n+\n+**False positives on XML names and spaces are gone, and some books epubcheck\n+fails now fail here too.** An EPUB 2 book with a decomposed Turkish letter in\n+an id failed here and passed epubcheck. It now passes here too. Names and\n+whitespace are now judged with epubcheck's own tables. Some books that epubcheck\n+fails now fail here as well, which is why this is a minor release. A book\n+epubcheck passes still passes here. The library's public API is unchanged.\n \n ### Fixed\n "},{"sha":"f32a648af94cc71b49576e50832cdf34df903944","filename":"Cargo.lock","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/veripublica/epubveri/blob/24102db6b1895022e91d1c546bd7de3d68d846da/Cargo.lock","raw_url":"https://github.com/veripublica/epubveri/raw/24102db6b1895022e91d1c546bd7de3d68d846da/Cargo.lock","contents_url":"https://api.github.com/repos/veripublica/epubveri/contents/Cargo.lock?ref=24102db6b1895022e91d1c546bd7de3d68d846da","patch":"@@ -34,7 +34,7 @@ dependencies = [\n \n [[package]]\n name = \"epubveri\"\n-version = \"0.21.1\"\n+version = \"0.22.0\"\n dependencies = [\n  \"roxmltree\",\n  \"serde\",\n@@ -56,7 +56,7 @@ dependencies = [\n \n [[package]]\n name = \"epubveri-wasm\"\n-version = \"0.21.1\"\n+version = \"0.22.0\"\n dependencies = [\n  \"epubveri\",\n  \"serde\","},{"sha":"c9a7d6e333d6d6faf1049d135fd8fbf100cc371a","filename":"Cargo.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/veripublica/epubveri/blob/24102db6b1895022e91d1c546bd7de3d68d846da/Cargo.toml","raw_url":"https://github.com/veripublica/epubveri/raw/24102db6b1895022e91d1c546bd7de3d68d846da/Cargo.toml","contents_url":"https://api.github.com/repos/veripublica/epubveri/contents/Cargo.toml?ref=24102db6b1895022e91d1c546bd7de3d68d846da","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"epubveri\"\n-version = \"0.21.1\"\n+version = \"0.22.0\"\n edition = \"2024\"\n rust-version = \"1.88\"\n description = \"Pure-Rust EPUB validator — a fast, JVM-free, embeddable alternative to epubcheck.\""},{"sha":"42fcb29a3218a20739adfce2262fb9d82a273870","filename":"epubveri-wasm/Cargo.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/veripublica/epubveri/blob/24102db6b1895022e91d1c546bd7de3d68d846da/epubveri-wasm%2FCargo.toml","raw_url":"https://github.com/veripublica/epubveri/raw/24102db6b1895022e91d1c546bd7de3d68d846da/epubveri-wasm%2FCargo.toml","contents_url":"https://api.github.com/repos/veripublica/epubveri/contents/epubveri-wasm%2FCargo.toml?ref=24102db6b1895022e91d1c546bd7de3d68d846da","patch":"@@ -1,6 +1,6 @@\n [package]\n name = \"epubveri-wasm\"\n-version = \"0.21.1\"\n+version = \"0.22.0\"\n edition = \"2024\"\n description = \"WebAssembly bindings for epubveri — a pure-Rust, JVM-free EPUB validator that runs in the browser.\"\n license = \"AGPL-3.0-only OR LicenseRef-veripublica-Commercial\""}]}